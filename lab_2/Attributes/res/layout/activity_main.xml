<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Random text" />

    <Button
        android:id="@+id/button_text_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Черный текст" />

    <Button
        android:id="@+id/button_text_red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Красный текст" />

    <Button
        android:id="@+id/button_8sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Размер - 8sp" />

    <Button
        android:id="@+id/button_24sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Размер - 24sp" />

    <Button
        android:id="@+id/button_background_white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Белый фон" />

    <Button
        android:id="@+id/button_background_yellow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Желтый фон" />
</LinearLayout>